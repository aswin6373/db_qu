APP_NAME=QueryMind
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_SSL=true
JWT_SECRET_KEY=change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FERNET_KEY=
RATE_LIMIT_PER_MINUTE=300
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OPENAI_API_KEY=
MYSQL_CONNECT_TIMEOUT=5
MYSQL_STATEMENT_TIMEOUT_MS=30000
FORWARDED_ALLOW_IPS=127.0.0.1

# --- WhatsApp AI chatbot (optional; the first three required to enable) ---
# Values come from developers.facebook.com > your app > WhatsApp.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Public origin of THIS backend, used to build user login links:
WHATSAPP_CONNECT_BASE_URL=
# Optional comma-separated sender allowlist (digits only) for testing only;
# production auth is per-user via magic-link pairing. Empty = open.
WHATSAPP_ALLOWED_NUMBERS=
# Set true on Vercel (serverless kills background threads); Docker keeps false.
WHATSAPP_INLINE_PROCESSING=false
