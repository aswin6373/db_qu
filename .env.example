# Copy this file to `.env` at the REPOSITORY ROOT before `docker compose up`.
# docker-compose.yml refuses to start without JWT_SECRET_KEY and FERNET_KEY.

# --- Backend secrets (required) ---
JWT_SECRET_KEY=generate-a-strong-random-value-of-32+-chars
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Backend options ---
ENVIRONMENT=local
GEMINI_API_KEY=
RATE_LIMIT_PER_MINUTE=300
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Frontend ---
# Leave empty to let the bundled nginx proxy /api calls to the backend service.
VITE_API_URL=

# --- Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=8080
